generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
model Jersey {
  id        Int      @id @default(autoincrement())
  team      String
  price     Int
  league    String
  createdAt DateTime @default(now())
}
model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
}

model Order {
  id        Int      @id @default(autoincrement())
  userId    Int
  total     Int
  status    String   @default("pending")
  createdAt DateTime @default(now())
  items     OrderItem[]
}

model OrderItem {
  id        Int      @id @default(autoincrement())
  orderId   Int
  order     Order    @relation(fields: [orderId], references: [id])
  team      String
  price     Int
  quantity  Int      @default(1)
}